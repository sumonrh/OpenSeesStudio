# OpenSees Tcl model generated by OpenSees Studio
# Units: kN, mm, tonne, s
wipe
model BasicBuilder -ndm 3 -ndf 6

# ---------------- materials ----------------
uniaxialMaterial Elastic 1 200
uniaxialMaterial Elastic 2 30

# ---------------- nodes --------------------
node 1 0 0 0
node 2 0 0 4000
node 3 6000 0 0
node 4 6000 0 4000

# ---------------- supports -----------------
fix 1 1 1 1 1 1 1
fix 2 0 1 0 1 0 1
fix 3 1 1 1 1 1 1
fix 4 0 1 0 1 0 1

# ---------------- elements -----------------
geomTransf Linear 1 1 0 0
element elasticBeamColumn 1 1 2 11700 200 76.92307692 765000 199327500 67522500 1
geomTransf Linear 2 1 0 0
element elasticBeamColumn 2 3 4 11700 200 76.92307692 765000 199327500 67522500 2
geomTransf Linear 3 0 0 1
element elasticBeamColumn 3 2 4 8192 200 76.92307692 356762.6667 229648682.7 17349290.67 3

# ---------------- loads --------------------
timeSeries Linear 1
pattern Plain 1 1 {
  eleLoad -ele 3 -type -beamUniform 0 -0.02
  # self weight, factor 1
  eleLoad -ele 1 -type -beamUniform 0 0
  eleLoad -ele 2 -type -beamUniform 0 0
  eleLoad -ele 3 -type -beamUniform 0 -0.0006306382029
}
timeSeries Linear 2
pattern Plain 2 2 {
}
timeSeries Linear 3
pattern Plain 3 3 {
  load 2 50 0 0 0 0 0
  load 4 50 0 0 0 0 0
}

# ---------------- load combinations -------
# COMB1 (Add): 1*DL + 1*LL
# DL+WIND (Add): 1*DL + 1*WIND
# 1.2DL+1.0WIND (Add): 1.2*DL + 1*WIND
# Apply a combination by scaling the matching pattern factors,
# e.g. pattern Plain 100 1 -fact 1.2 { ... }

# ---------------- analysis ------------------
constraints Plain
numberer RCM
system BandGen
algorithm Linear
integrator LoadControl 1.0
analysis Static
puts "Analysis terminated with code [analyze 1]"

puts "Node displacements:"
puts "  node 1: [nodeDisp 1]"
puts "  node 2: [nodeDisp 2]"
puts "  node 3: [nodeDisp 3]"
puts "  node 4: [nodeDisp 4]"